DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-for-local-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DATABASE_ENGINE=postgresql
DATABASE_URL=postgresql://dmquote:change-me@db:5432/dmquote
DATABASE_CONN_MAX_AGE=60
POSTGRES_DB=dmquote
POSTGRES_USER=dmquote
POSTGRES_PASSWORD=change-me
DJANGO_SUPERUSER_USERNAME=depechejuan
DJANGO_SUPERUSER_PASSWORD=change-me-not-for-commit
DJANGO_SUPERUSER_EMAIL=
# Set DATABASE_ENGINE=sqlite only for a dependency-only local smoke test.
DMLIVE_IMPORT_ENABLED=false
DMLIVE_SNAPSHOT_DIR=snapshots
DMLIVE_USER_AGENT=DMQuote/0.1 (+https://example.invalid/contact)
DMLIVE_REQUEST_DELAY_SECONDS=15
# DeepL API Free credentials stay in the backend environment only.
DEEPL_AUTH_KEY=
DEEPL_API_BASE_URL=https://api-free.deepl.com
DEEPL_MAX_MONTHLY_CHARACTERS=500000
