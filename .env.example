# Set DATABASE_ENGINE=sqlite for a dependency-only local smoke test.
DATABASE_ENGINE=postgresql
DMLIVE_IMPORT_ENABLED=false
DMLIVE_USER_AGENT=DMQuote/0.1 (+https://example.invalid/contact)
DMLIVE_REQUEST_DELAY_SECONDS=15
